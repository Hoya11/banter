# judge용 OpenAI API 키 (https://platform.openai.com/api-keys)
# 실제 키는 server/.env 에 넣는다 (.env 는 git에 커밋되지 않음)
OPENAI_API_KEY=

# Langfuse Cloud (https://cloud.langfuse.com) — 채점 trace 기록
# 키를 비워두면 트레이싱 비활성(NoopSink)이라 개발엔 필수 아님
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
