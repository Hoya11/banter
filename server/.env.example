# 발화·supervisor·judge·OpenAI TTS용 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Langfuse Cloud (https://cloud.langfuse.com) — 채점 trace 기록 (선택, 없으면 NoopSink)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ElevenLabs TTS (https://elevenlabs.io). 선택 사항이며 비우면 AI 음성 없이 실행
ELEVENLABS_API_KEY=

# 로컬 끼어들기 이벤트 기록 (선택, 대화 원문은 저장하지 않음)
BANTER_EVENT_LOG=

# STT 방식. 기본은 기존 파일 전사이며 streaming_push_to_talk로 비교 실행 가능
BANTER_STT_MODE=record_then_transcribe

# 입력 방식. vad는 streaming_push_to_talk와 로컬 VAD 자산 설치가 필요
BANTER_INTERACTION_MODE=push_to_talk

# 배포나 기준 측정에서 명시적으로 남길 코드 버전 (선택, 비우면 Git에서 자동 확인)
BANTER_BUILD_VERSION=
